+	struct object_datum *object = object_try_and_get(object_index);
+	struct object_definition *object_definition;
+	struct object_attachment_definition *found = NULL;
+	struct point_light_definition *definition = NULL;
+	short attachment_index;
+	real intensity = 0.0f;
+
+	if (!object)
+		return FALSE;
+	object_definition = object_definition_get(object->definition_index);
+	for (attachment_index = 0; attachment_index < object_definition->object.attachments.count; attachment_index++)
+	{
+		struct object_attachment_definition *attachment = TAG_BLOCK_GET_ELEMENT(
+			&object_definition->object.attachments,
+			attachment_index,
+			struct object_attachment_definition);
+		struct point_light_definition *candidate;
+
+		if (attachment->type.group_tag != LIGHT_DEFINITION_TAG || attachment->type.index == NONE)
+			continue;
+		candidate = light_definition_get(attachment->type.index);
+		if (TEST_FLAG(candidate->flags, _light_definition_is_first_person_flashlight_bit) || !found)
+		{
+			found = attachment;
+			definition = candidate;
+			if (TEST_FLAG(candidate->flags, _light_definition_is_first_person_flashlight_bit))
+				break;
+		}
+	}
+	if (!found)
+		return FALSE;
+
+	object_get_function_value(object_index, found->primary_scale_function_reference - 1, &intensity);
+	rgb_colors_interpolate_and_scale(
+		color,
+		definition->color_interpolation_flags,
+		&definition->color_lower_bound,
+		&definition->color_upper_bound,
+		found->change_color_reference - 1 == NONE
+			? global_real_rgb_white
+			: &object->object.outgoing_change_colors[found->change_color_reference - 1],
+		intensity);
+	*radius = (definition->radius_modifier_lower_bound * (1.0f - intensity)
+		+ definition->radius_modifier_upper_bound * intensity)
+		* definition->radius;
+	*cutoff_angle = definition->cutoff_angle;
+	*falloff_angle = definition->falloff_angle;
+	return TRUE;
+}
